# Static hosting rules for Hostinger (Apache / LiteSpeed)
Options -MultiViews
DirectorySlash Off
RewriteEngine On

# One address only: https://relationshipgoals.store (no www, no http)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Drop trailing slash: /guides/x/ -> /guides/x
RewriteCond %{REQUEST_URI} !^/$
RewriteRule ^(.+)/$ /$1 [L,R=301]

# Serve prerendered pages: /guides/x -> /guides/x/index.html
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.*)$ $1/index.html [L]

# Unknown URLs: app shell renders the 404 page
ErrorDocument 404 /__spa-fallback.html

# Caching: hashed assets forever, pages short
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|png|jpg|webp|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|data|xml|txt)$">
    Header set Cache-Control "public, max-age=300"
  </FilesMatch>
</IfModule>
