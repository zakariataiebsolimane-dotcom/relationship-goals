[{"_1":2,"_3":4},"root",{"_5":29},"routes/ideas.$slug",{"_5":6},"data",{"_7":8},"idea",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28},"slug","weekend-layers","name","Your off-duty duo","description","Simple casual layers for coffee runs, park walks and all the little adventures in between.","image","/images/2186b10b-371f-44ad-baba-cd3142187b60.webp","alt","A couple walking together in coordinated neutral-toned autumn outfits","link","#","category","couple-style","occasion","Everyday together","why","Comfortable outfits make it easier to say yes to a spontaneous plan. Try a light jacket over your favorite tee and echo one color in your partner’s outfit.","tip","Start with pieces you already own. If you add a layer, choose something you will also wear on your own.",{"_30":31},"origin","https://relationshipgoals.store"]
