[{"_1":2,"_3":4},"root",{"_5":29},"routes/ideas.$slug",{"_5":6},"data",{"_7":8},"idea",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28},"slug","valentines-roses","name","Roses and a little something extra","description","Pair a bouquet of roses with a small keepsake for a Valentine’s gift that feels personal, not generic.","image","/images/feac02be-0fe1-4ccf-b906-2af764a229f3.webp","alt","Red roses and a heart-shaped box of chocolates on a soft pink background","link","#","category","valentines","occasion","Valentine's Day","why","Flowers are lovely on their own, but a keepsake is what they will still have next year. Choose something that echoes a shared memory.","tip","Order flowers early for Valentine’s delivery. A handwritten card matters more than the gift itself.",{"_30":31},"origin","https://relationshipgoals.store"]
