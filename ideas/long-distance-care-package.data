[{"_1":2,"_3":4},"root",{"_5":29},"routes/ideas.$slug",{"_5":6},"data",{"_7":8},"idea",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28},"slug","long-distance-care-package","name","A care package across the miles","description","Fill a box with their favorite snacks, a handwritten letter and small reminders of you for a long-distance surprise.","image","/images/874f4fa4-abe9-4eba-b5c4-36c26fe5c080.webp","alt","Open gift box filled with wrapped presents, letters and small treats","link","#","category","long-distance","occasion","Missing you","why","When you cannot be there in person, a thoughtfully packed box arrives for them instead. Mix practical treats with a few sentimental touches.","tip","Check shipping times and any customs rules for international parcels. Pad fragile items well.",{"_30":31},"origin","https://relationshipgoals.store"]
