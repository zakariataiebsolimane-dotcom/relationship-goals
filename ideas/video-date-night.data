[{"_1":2,"_3":4},"root",{"_5":29},"routes/ideas.$slug",{"_5":6},"data",{"_7":8},"idea",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28},"slug","video-date-night","name","A real date over video call","description","Set the same scene in two places — candles, a shared playlist and a meal — and a video call becomes a proper date night.","image","/images/4a8c4881-62f8-4eac-980d-8d0eed46804e.webp","alt","A couple smiling at each other through a laptop video call in cozy living rooms","link","#","category","long-distance","occasion","Date night apart","why","Distance does not have to cancel date night. Agree on a time, dress up a little and give the call your full attention the way you would a dinner out.","tip","Test your connection and lighting beforehand. A small tripod keeps your hands free.",{"_30":31},"origin","https://relationshipgoals.store"]
