[{"_1":2,"_3":4},"root",{"_5":29},"routes/ideas.$slug",{"_5":6},"data",{"_7":8},"idea",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28},"slug","conversation-night","name","Less scrolling. More connecting.","description","Couples conversation cards make an at-home evening a chance to discover something new about each other.","image","/images/d270a125-bb25-453d-8e1e-93be54c07317.webp","alt","A deck of question cards fanned out on a coffee table with two mugs","link","#","category","date-night","occasion","At-home date night","why","Even long-term partners have stories they have never shared. Take turns picking a prompt and give each other room to answer without rushing.","tip","Choose a deck with questions that fit your comfort level. Skip any prompt that feels too personal; this is connection, not a test.",{"_30":31},"origin","https://relationshipgoals.store"]
