[{"_1":2,"_3":4},"root",{"_5":29},"routes/ideas.$slug",{"_5":6},"data",{"_7":8},"idea",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28},"slug","morning-coffee-mugs","name","Your morning, made sweeter","description","A pair of ceramic mugs for slow mornings and coffee together. Add their favorite beans for a personal touch.","image","/images/e04a6aaa-c654-4d38-9b39-166733cb30e1.webp","alt","Two ceramic coffee mugs on a wooden table beside a cozy blanket","link","#","category","gifts-for-her","occasion","Everyday just-because","why","A useful little gift becomes a daily reminder of your person. Choose colors and shapes that feel like each of you, rather than a matching slogan.","tip","Look for dishwasher-safe mugs and check the capacity. Tuck a handwritten note inside before wrapping.",{"_30":31},"origin","https://relationshipgoals.store"]
