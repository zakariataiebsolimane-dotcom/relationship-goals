[{"_1":2,"_3":4},"root",{"_5":29},"routes/ideas.$slug",{"_5":6},"data",{"_7":8},"idea",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28},"slug","his-everyday-carry","name","Upgrade his everyday carry","description","A slim leather wallet and a classic watch are small upgrades he will use every single day.","image","/images/eb2dd3d3-a6b8-4711-ab59-7ff2b6995f85.webp","alt","Flat lay of a leather wallet, wristwatch and folded sweater on a wooden surface","link","#","category","gifts-for-him","occasion","Just-because","why","The best gifts for him are the ones that replace something worn out. Look for quality materials and a style that fits what he already wears.","tip","Note his watch size and wallet preference (bifold or cardholder) before you buy.",{"_30":31},"origin","https://relationshipgoals.store"]
